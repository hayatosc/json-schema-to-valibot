{
  "name": "json-schema-to-valibot",
  "version": "0.3.1",
  "description": "Convert JSON Schema definitions to Valibot schema definitions. Inspired by json-schema-to-zod.",
  "keywords": [
    "cli",
    "converter",
    "json-schema",
    "schema",
    "typescript",
    "valibot",
    "validation"
  ],
  "license": "MIT",
  "author": "hayatosc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hayatosc/json-schema-to-valibot.git"
  },
  "bin": {
    "json-schema-to-valibot": "dist/cli.cjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/cli.ts",
    "test": "pnpm test:dev && pnpm test:e2e && pnpm test:suite",
    "test:dev": "vitest --exclude='**/end-to-end.test.ts'",
    "test:e2e": "pnpm build && vitest end-to-end.test.ts",
    "test:suite": "pnpm build && tsx script/test-suite-runner.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "citty": "^0.1.6",
    "valibot": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "oxlint-tsgolint": "^0.23.0",
    "tsdown": "0.12.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.12.1+sha512.f0dda8580f0ee9481c5c79a1d927b9164f2c478e90992ad268bbb2465a736984391d6333d2c327913578b2804af33474ca554ba29c04a8b13060a717675ae3ac"
}
